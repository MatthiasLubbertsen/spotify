# Copy to .env and fill in. See AGENTS.md section 6 for every option.

# Public hostname (Traefik router rule) and the matching public base URL.
DOMAIN=spotify.matthiaz.dev
PUBLIC_URL=https://spotify.matthiaz.dev

# REQUIRED. Encrypts upstream tokens and client secrets at rest. >= 32 chars.
# Generate with: openssl rand -base64 32
# Losing or changing it makes stored tokens/secrets unreadable (users must log in again,
# virtual-app secrets must be rotated).
SECRET_KEY=

# Optional: seed the real Spotify app. Can also be entered in the dashboard (Spotify app page).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Header Tinyauth sets after login (forward-auth authResponseHeaders). The dashboard refuses
# requests without it.
DASHBOARD_USER_HEADER=Remote-User
# Optional comma separated list of usernames allowed into the dashboard (empty = anyone Tinyauth lets in).
DASHBOARD_ALLOWED_USERS=

# Fixed upstream redirect path registered at Spotify: <PUBLIC_URL><path>. Changing it means
# updating the Redirect URI in the Spotify Developer Dashboard too.
UPSTREAM_CALLBACK_PATH=/callback

# Traefik wiring (docker-compose.yml)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TINYAUTH_MIDDLEWARE=tinyauth@docker
